+// ======== TCP keep-alive policy ========
+
+// Linux defaults, from net.ipv4.tcp_keepalive_{time,intvl,probes}.
+pub(crate) const TCP_KEEPIDLE_DEFAULT_SECS: u32 = 7200;
+pub(crate) const TCP_KEEPINTVL_DEFAULT_SECS: u32 = 75;
+pub(crate) const TCP_KEEPCNT_DEFAULT: u32 = 9;
+
+// Linux bounds the three knobs in include/net/tcp.h: KEEPIDLE/KEEPINTVL are
+// 1..=MAX_TCP_KEEPIDLE and KEEPCNT is 1..=MAX_TCP_KEEPCNT.
+pub(crate) const TCP_KEEPALIVE_MAX_SECS: u32 = 32767;
+pub(crate) const TCP_KEEPALIVE_MAX_PROBES: u32 = 127;
+
+/// Range check for one keep-alive knob.
+///
+/// The lower bound is not cosmetic. smoltcp arms its keep-alive deadline at
+/// `now + interval` and treats `now >= deadline` as due, so an interval of zero
+/// is due on every poll: the network poller re-arms without making progress and
+/// probes leave at poll frequency. Linux rejects 0 for all three knobs, and so
+/// does this.
+pub(crate) fn keepalive_value_in_range(value: u32, max: u32) -> bool {
+    value != 0 && value <= max
+}
